# Copia este archivo a .env.docker y completa los valores reales.
# .env.docker NO debe subirse a git (ya está en .gitignore).

# IP pública del servidor Hetzner (sin http:// ni puerto).
SERVER_IP=94.130.182.254

# Password del usuario "sa" de SQL Server. Requisito de SQL Server: mínimo 8
# caracteres, con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=CambiaEsto123!

# Cualquier string aleatorio largo sirve. Generar uno nuevo, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET_KEY=CambiaEstoPorUnaLlaveAleatoriaLarga

# Cuenta de Gmail que manda el correo real (invitaciones, activación de cuenta,
# reseteo de contraseña) — no es tu contraseña normal, es una "contraseña de
# aplicación" que se genera en https://myaccount.google.com/apppasswords (requiere
# tener la verificación en dos pasos activada en esa cuenta de Google).
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=CambiaEstoPorTuContraseñaDeAplicacion
